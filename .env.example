# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (application role, owner of the nexus_bi database) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_bi
POSTGRES_USER=nexus_app
POSTGRES_PASSWORD=change_me

# --- API ---
ENVIRONMENT=development
# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
API_CACHE_TTL_SECONDS=300
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000
LOG_LEVEL=INFO

# --- AI analyst ---
# auto = Claude if ANTHROPIC_API_KEY is set, else a local Ollama model if running, else guided mode
# (a free library of questions answered with prepared SQL, no AI). Options: auto | anthropic | ollama | guided
AI_PROVIDER=auto
# Free local AI: install https://ollama.com and run `ollama pull qwen2.5-coder:7b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Paid, best quality: Anthropic Claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=high
AI_RATE_LIMIT_PER_MINUTE=6
# Optional: require this token in the X-Access-Token header (recommended when deployed publicly).
AI_ACCESS_TOKEN=
# Optional dedicated read-only database role for AI-generated SQL (create it with sql/roles.sql).
AI_DB_USER=
AI_DB_PASSWORD=
